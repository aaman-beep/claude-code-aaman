# Copy this file OUTSIDE the repo (e.g. ~/Downloads/scaletopia-stats-keys.env), fill it in, send it privately.
# Never commit the filled-in file. The repo is public.
# GHL: Settings > Private Integrations in each sub-account (starts with pit-)
GHL_LEGACY_TOKEN=pit-...           # sub-account UqMcuYNiET94KiGWH5Ec (619 / 314 / 479 numbers)
GHL_TOLLFREE_TOKEN=pit-...         # sub-account TYVYHj7lX8bamHkOKz4s (toll-free)
# EmailBison: send.scaletopia.io > Settings > API keys (Scaletopia workspace)
EMAILBISON_KEY=
EMAILBISON_URL=https://send.scaletopia.io
# Evergreen API key (same one in Aaman's repo .env)
EVERGREEN_API_KEY=
